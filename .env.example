# =============================================================================
# .env.example - Environment Variables Template
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control - it contains sensitive credentials!
#
# =============================================================================

# GitHub Personal Access Token for runner registration
# Generate at: Settings > Actions > Runners > New self-hosted runner
# Note: Tokens expire after 1 hour and are single-use
ACCESS_TOKEN=

# GitHub Organization name (case-sensitive)
ORGANIZATION=OpenCloudHub
